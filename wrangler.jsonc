{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "quick-task",
  "compatibility_date": "2026-11-01",
  // Static site only. No Worker code runs.
  "assets": { "directory": "." },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "quicktask.ravishxt.com", "custom_domain": true }]
}
